# Public production contact JSON is supplied by the owner; see scripts/contact-policy.mjs
SITE_CONTACT_JSON=
VITE_BASE=/
# Public preview is disabled unless explicitly enabled.
DEMO_MODE=off
# Server inquiry channel only. Keep these values in private runtime configuration.
INQUIRY_DATA_FILE=
PUBLIC_URL=
INQUIRY_ADMIN_PASSWORD=
# Optional exact IPs of the immediate gateway; otherwise production resolves gateway.
INQUIRY_TRUSTED_PROXY_IPS=
# Optional generic HTTPS mail adapter. Leave all three blank until owner approval.
INQUIRY_EMAIL_URL=
INQUIRY_EMAIL_KEY=
INQUIRY_EMAIL_TO=
